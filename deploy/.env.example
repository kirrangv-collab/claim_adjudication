# ClaimLab deployment settings. Create the real file with:
#   bash deploy/configure.sh --domain your-name.duckdns.org
# (it generates strong random secrets). Never commit deploy/.env.

# Public hostname Caddy obtains an HTTPS certificate for. Use "localhost" to test locally.
DOMAIN=claimlab.example.duckdns.org

# Stack size. Empty = "lite" (in-memory vector/graph stores, ~1 GB RAM).
# "full" adds Qdrant + Neo4j (~3-4 GB RAM); then also set the two backends below.
COMPOSE_PROFILES=
CLAIMLAB_VECTOR_BACKEND=memory
CLAIMLAB_GRAPH_BACKEND=memory

# Secrets (configure.sh generates these).
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
NEO4J_PASSWORD=change-me

# Public demo: shows demo-maker / demo-checker credentials on the login page.
CLAIMLAB_PUBLIC_DEMO=true
CLAIMLAB_DEMO_PASSWORD=try-claimlab

# Optional: Google Gemini key for LLM assists + comparison engine (costs money; leave empty for a public site).
CAF_MODEL_API_KEY=

# Optional tuning.
# RATE_LIMIT_REQUESTS=60          # write requests per IP per minute
# STP_APPROVE_THRESHOLD=0.90
# STP_DENY_THRESHOLD=0.95
# CLAIMLAB_EMBEDDER=hashing       # "sbiobert" needs INSTALL_SBIOBERT=true and ~2 GB more RAM
# INSTALL_SBIOBERT=false
# HTTP_PORT=80
# HTTPS_PORT=443
# INTERNAL_SUBNET=172.30.0.0/24   # change only if it clashes with your network
# API_IMAGE=ghcr.io/<owner>/claimlab-api:latest   # use published images instead of building
# WEB_IMAGE=ghcr.io/<owner>/claimlab-web:latest
